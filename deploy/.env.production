# ============================================================
#  AI-YIHU 生产环境配置
#  部署前必须修改所有标记 [必填] 的配置项
# ============================================================

# ===== 基础配置 =====
PORT=3000
NODE_ENV=production

# ===== MySQL 配置 =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=escort_user
MYSQL_PASSWORD=YIHU_CHANGEME_2026
MYSQL_DATABASE=community_medical
MYSQL_ROOT_PASSWORD=YIHU_ROOT_CHANGEME_2026
MYSQL_CONNECTION_LIMIT=10

# ===== JWT 配置 =====
JWT_SECRET=YIHU_JWT_CHANGEME_USE_RANDOM_64CHARS
JWT_EXPIRES_IN=7d

# ===== 微信小程序 / 支付配置 [必填] =====
WX_APPID=wxce306b36ada907da
WX_SECRET=
WX_MCHID=
WX_API_V3_KEY=
WX_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WX_SERIAL_NO=
WX_NOTIFY_URL=https://YOUR_DOMAIN/api/v1/pay/notify

# ===== 派单配置 =====
DISPATCH_RESPONSE_TIMEOUT_SECONDS=60
DISPATCH_MAX_RETRY=5

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# ===== 默认社区 =====
DEFAULT_COMMUNITY_ID=1
