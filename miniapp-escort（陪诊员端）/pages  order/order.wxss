.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }

/* Tab栏 */
.tab-bar { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab-item.active { color: #1677ff; font-weight: bold; }
.tab-item.active::after { content: ''; position: absolute; bottom: 0; left: 30%; right: 30%; height: 4rpx; background: #1677ff; border-radius: 2rpx; }

/* 订单卡片 */
.order-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05); }
.order-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.hospital { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.service-type { font-size: 22rpx; color: #1677ff; background: #e6f4ff; padding: 2rpx 12rpx; border-radius: 12rpx; margin-top: 6rpx; display: inline-block; }
.amount { font-size: 32rpx; font-weight: bold; color: #ff4d4f; }
.status-tag { font-size: 22rpx; color: #fff; background: #1677ff; padding: 4rpx 16rpx; border-radius: 20rpx; }

.order-detail-row { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }

/* 操作按钮 */
.order-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.btn-reject, .btn-accept { flex: 1; padding: 18rpx 0; border-radius: 12rpx; text-align: center; font-size: 28rpx; border: none; }
.btn-reject { background: #f5f5f5; color: #999; }
.btn-accept { background: #1677ff; color: #fff; font-weight: bold; }

/* 空状态 */
.empty { text-align: center; padding: 80rpx 20rpx; }
.empty text { display: block; font-size: 28rpx; color: #999; }
.empty-sub { font-size: 22rpx; color: #ccc; margin-top: 10rpx; }
