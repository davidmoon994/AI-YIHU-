.page { background: #f5f5f5; min-height: 100vh; padding: 20rpx; }
.page-title { font-size: 36rpx; font-weight: bold; color: #333; padding: 20rpx 10rpx 0; }
.page-sub { font-size: 24rpx; color: #999; padding: 8rpx 10rpx 20rpx; }

/* 课程卡片 */
.course-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04); }
.course-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.course-title { font-size: 30rpx; font-weight: bold; color: #333; flex: 1; }
.course-category { font-size: 22rpx; color: #1677ff; background: #e6f4ff; padding: 4rpx 16rpx; border-radius: 12rpx; margin-left: 12rpx; }
.course-meta { font-size: 22rpx; color: #999; display: flex; gap: 20rpx; }

/* 空状态 */
.empty { text-align: center; padding: 100rpx 0; }
.empty text { font-size: 28rpx; color: #ccc; }

/* 弹窗遮罩 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: flex-end; }
.detail-panel { background: #fff; width: 100%; border-radius: 24rpx 24rpx 0 0; max-height: 80vh; display: flex; flex-direction: column; }
.detail-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #eee; }
.detail-title { font-size: 32rpx; font-weight: bold; color: #333; flex: 1; }
.detail-close { font-size: 36rpx; color: #999; padding: 10rpx; }
.detail-content { flex: 1; padding: 24rpx; max-height: 50vh; }
.detail-meta { font-size: 24rpx; color: #999; margin-bottom: 20rpx; display: flex; gap: 30rpx; }
.detail-body { font-size: 28rpx; color: #444; line-height: 1.8; }
.detail-footer { padding: 20rpx 24rpx; padding-bottom: 40rpx; border-top: 1rpx solid #eee; }
.btn-finish { background: #1677ff; color: #fff; border-radius: 12rpx; font-size: 30rpx; padding: 24rpx 0; border: none; }
