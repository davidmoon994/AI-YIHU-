.page { background: #f5f5f5; min-height: 100vh; }

/* 收入卡片 */
.income-card { background: linear-gradient(135deg, #1677ff, #00c6ff); color: #fff; padding: 50rpx 30rpx; text-align: center; }
.income-label { font-size: 26rpx; opacity: 0.9; display: block; }
.income-amount { font-size: 64rpx; font-weight: bold; display: block; margin: 16rpx 0; }
.income-meta { font-size: 24rpx; opacity: 0.8; }

/* 筛选 */
.filter-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.filter-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.filter-row { display: flex; gap: 20rpx; }
.date-picker { font-size: 24rpx; color: #666; background: #f5f5f5; padding: 16rpx 20rpx; border-radius: 10rpx; flex: 1; text-align: center; }

/* 统计 */
.stat-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.stat-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.stat-row:last-child { border-bottom: none; }
.stat-label { font-size: 28rpx; color: #666; }
.stat-value { font-size: 28rpx; color: #333; font-weight: bold; }
.stat-value.highlight { color: #ff4d4f; font-size: 32rpx; }

/* 提示 */
.tip-card { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.tip-title { font-size: 26rpx; font-weight: bold; color: #333; display: block; margin-bottom: 12rpx; }
.tip-text { font-size: 24rpx; color: #999; display: block; margin-bottom: 8rpx; }
