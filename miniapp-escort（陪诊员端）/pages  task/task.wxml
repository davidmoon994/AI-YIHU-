<view class="page">

  <view class="page-title">我的任务</view>

  <!-- 任务列表 -->
  <block wx:if="{{orders.length > 0}}">
    <view class="task-card" wx:for="{{orders}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="task-header">
        <view>
          <text class="task-hospital">{{item.hospital_name || '未指定医院'}}</text>
          <text class="task-no">{{item.order_no}}</text>
        </view>
        <view class="task-status task-status-{{item.order_status}}">
          {{item.order_status === 'assigned' ? '已指派' : item.order_status === 'arrived' ? '已到达' : item.order_status === 'serving' ? '服务中' : item.order_status}}
        </view>
      </view>

      <!-- 订单信息 -->
      <view class="task-info">
        <text>👤 {{item.patient_name || '未知'}} {{item.patient_phone || ''}}</text>
      </view>
      <view class="task-info">
        <text>📍 {{item.service_address || '待确认'}}</text>
      </view>
      <view class="task-info">
        <text>🕐 {{item.appointment_time || '待定'}}</text>
      </view>
      <view class="task-info">
        <text>💰 ¥{{item.payable_amount}}</text>
      </view>

      <!-- 流程进度条 -->
      <view class="progress-bar">
        <view class="step {{item.order_status === 'assigned' || item.order_status === 'arrived' || item.order_status === 'serving' || item.order_status === 'completed' ? 'done' : ''}}">指派</view>
        <view class="step-line {{item.order_status === 'arrived' || item.order_status === 'serving' || item.order_status === 'completed' ? 'done' : ''}}"></view>
        <view class="step {{item.order_status === 'arrived' || item.order_status === 'serving' || item.order_status === 'completed' ? 'done' : ''}}">到达</view>
        <view class="step-line {{item.order_status === 'serving' || item.order_status === 'completed' ? 'done' : ''}}"></view>
        <view class="step {{item.order_status === 'serving' || item.order_status === 'completed' ? 'done' : ''}}">服务</view>
        <view class="step-line {{item.order_status === 'completed' ? 'done' : ''}}"></view>
        <view class="step {{item.order_status === 'completed' ? 'done' : ''}}">完成</view>
      </view>

      <!-- 操作按钮 -->
      <view class="task-actions">
        <button wx:if="{{item.order_status === 'assigned'}}" class="btn-primary" bindtap="arrive" data-id="{{item.id}}">
          确认到达
        </button>
        <button wx:if="{{item.order_status === 'arrived'}}" class="btn-primary" bindtap="startService" data-id="{{item.id}}">
          开始服务
        </button>
        <block wx:if="{{item.order_status === 'serving'}}">
          <button class="btn-secondary" bindtap="uploadPhoto" data-id="{{item.id}}">上传照片并完成</button>
          <button class="btn-primary" bindtap="finishService" data-id="{{item.id}}">直接完成</button>
        </block>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && orders.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无进行中的任务</text>
    <text class="empty-sub">接单后将在此显示</text>
  </view>

</view>
