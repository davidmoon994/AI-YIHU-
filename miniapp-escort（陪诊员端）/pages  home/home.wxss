.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 40rpx; }

/* 头部 */
.header { display: flex; align-items: center; background: linear-gradient(135deg, #1677ff, #00c6ff); padding: 40rpx 30rpx; color: #fff; }
.avatar-wrap { margin-right: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.6); background: #ddd; }
.header-info { flex: 1; }
.name { font-size: 32rpx; font-weight: bold; display: block; margin-bottom: 10rpx; }
.status-row { display: flex; align-items: center; }
.status-label { font-size: 24rpx; }
.status-text { font-size: 24rpx; margin-left: 10rpx; }
.status-text.online { color: #b7ff8f; }
.status-text.offline { color: rgba(255,255,255,0.7); }

/* 统计卡片 */
.stats-card { display: flex; background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 30rpx 0; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: bold; color: #303133; display: block; }
.stat-label { font-size: 22rpx; color: #999; margin-top: 6rpx; display: block; }

/* 快捷操作 */
.action-grid { display: flex; flex-wrap: wrap; padding: 0 20rpx; }
.action-item { width: 25%; text-align: center; padding: 20rpx 0; }
.action-icon { font-size: 48rpx; display: block; }
.action-text { font-size: 22rpx; color: #666; margin-top: 8rpx; display: block; }

/* 区块标题 */
.section-title { font-size: 28rpx; font-weight: bold; color: #333; padding: 20rpx 24rpx 10rpx; }

/* 订单卡片 */
.order-card { background: #fff; margin: 0 20rpx; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.order-header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.order-no { font-size: 26rpx; font-weight: bold; color: #333; }
.order-status { font-size: 22rpx; color: #1677ff; background: #e6f4ff; padding: 4rpx 16rpx; border-radius: 20rpx; }
.order-info { font-size: 24rpx; color: #666; margin-bottom: 10rpx; }

/* 空状态 */
.empty-card { background: #fff; margin: 0 20rpx; border-radius: 16rpx; padding: 60rpx 24rpx; text-align: center; }
.empty-text { font-size: 28rpx; color: #999; display: block; }
.empty-sub { font-size: 22rpx; color: #ccc; margin-top: 10rpx; display: block; }

/* 退出登录 */
.logout-btn { margin: 40rpx 20rpx; text-align: center; padding: 24rpx; background: #fff; border-radius: 16rpx; color: #ff4d4f; font-size: 28rpx; }
