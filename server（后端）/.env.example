# ===== 基础配置 =====
PORT=3000
NODE_ENV=development

# ===== MySQL 配置 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=escort_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=community_medical
MYSQL_CONNECTION_LIMIT=10

# ===== JWT 配置 =====
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== 微信小程序 / 支付配置 =====
WX_APPID=
WX_SECRET=
WX_MCHID=
WX_API_V3_KEY=
WX_PRIVATE_KEY_PATH=./cert/apiclient_key.pem
WX_SERIAL_NO=
WX_NOTIFY_URL=https://your-domain.com/api/v1/pay/notify

# ===== 派单默认配置（可被system_configs覆盖）=====
DISPATCH_RESPONSE_TIMEOUT_SECONDS=60
DISPATCH_MAX_RETRY=5

# ===== 文件上传 =====
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10

# ===== 默认社区（单社区阶段固定为1）=====
DEFAULT_COMMUNITY_ID=1
