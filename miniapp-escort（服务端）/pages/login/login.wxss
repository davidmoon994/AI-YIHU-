page { background: #f5f6f8; min-height: 100vh; }
.page { padding: 180rpx 40rpx 60rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 50rpx 40rpx; }
.title { font-size: 42rpx; font-weight: 700; color: #222; }
.sub { margin-top: 14rpx; margin-bottom: 50rpx; color: #888; font-size: 26rpx; }
.input { height: 92rpx; border-bottom: 1px solid #eee; margin-bottom: 24rpx; font-size: 30rpx; }
.btn { margin-top: 36rpx; background: #1677ff; color: #fff; border-radius: 46rpx; }
