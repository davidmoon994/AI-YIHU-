<view class="page">

  <!-- 头像与状态区 -->
  <view class="header">
    <view class="avatar-wrap">
      <image class="avatar" src="{{profile.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    </view>
    <view class="header-info">
      <text class="name">{{profile.name || '服务人员'}}</text>
      <view class="status-row">
        <text class="status-label">状态：</text>
        <switch checked="{{online}}" bindchange="toggleOnline" color="#1677ff" />
        <text class="status-text {{online ? 'online' : 'offline'}}">{{online ? '在线接单' : '离线'}}</text>
      </view>
    </view>
  </view>

  <!-- 今日数据 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{todayOrders}}</text>
      <text class="stat-label">今日接单</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{profile.rating || '5.00'}}</text>
      <text class="stat-label">服务评分</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{profile.completed_orders || 0}}</text>
      <text class="stat-label">累计完成</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="action-grid">
    <view class="action-item" bindtap="goOrders">
      <text class="action-icon">📋</text>
      <text class="action-text">待接订单</text>
    </view>
    <view class="action-item" bindtap="goLearn">
      <text class="action-icon">📚</text>
      <text class="action-text">学习中心</text>
    </view>
    <view class="action-item" bindtap="goWallet">
      <text class="action-icon">💰</text>
      <text class="action-text">我的钱包</text>
    </view>
    <view class="action-item" bindtap="reportLocation">
      <text class="action-icon">📍</text>
      <text class="action-text">上报位置</text>
    </view>
    <view class="action-item" bindtap="goProfile">
      <text class="action-icon">👤</text>
      <text class="action-text">服务资料</text>
    </view>
  </view>

  <!-- 当前订单 -->
  <view class="section-title">当前任务</view>

  <view class="order-card" wx:if="{{currentOrder}}">
    <view class="order-header">
      <text class="order-no">{{currentOrder.order_no}}</text>
      <text class="order-status">{{currentOrder.order_status}}</text>
    </view>
    <view class="order-info">
      <text>🏷️ 服务：{{currentOrder.service_type === 'elderly_care' ? '老人陪护' : currentOrder.service_type === 'childcare' ? '儿童托管' : currentOrder.service_type === 'pet_care' ? '宠物托管' : currentOrder.service_type === 'medical_escort' || currentOrder.service_type === 'escort' ? '就医陪诊' : currentOrder.service_type === 'register' ? '代挂号' : currentOrder.service_type === 'pickup' ? '接送服务' : currentOrder.service_type || '家庭服务'}}</text>
    <text>📍 {{currentOrder.service_address || currentOrder.hospital_name || '待确认服务地点'}}</text>
    </view>
    <view class="order-info">
      
      <text>🕐 预约：{{currentOrder.appointment_time || '待定'}}</text>
    </view>
    <view class="order-info">
      <text>👤 {{currentOrder.service_type === 'pet_care' ? '宠物' : currentOrder.service_type === 'childcare' ? '儿童' : currentOrder.service_type === 'elderly_care' ? '老人' : '服务对象'}}：{{currentOrder.patient_name || currentOrder.service_object_name || '待确认'}}</text>
    </view>
  </view>

  <view class="empty-card" wx:else>
    <text class="empty-text">暂无进行中的订单</text>
    <text class="empty-sub">开启在线状态后，系统会推送匹配的家庭服务订单</text>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="logout">退出登录</view>

</view>
