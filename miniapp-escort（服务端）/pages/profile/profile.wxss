.page { min-height: 100vh; background: #f5f7fa; padding-bottom: 60rpx; }
.hero { display: flex; align-items: center; padding: 42rpx 30rpx; background: linear-gradient(135deg, #1677ff, #00c6ff); color: #fff; }
.avatar-wrap { margin-right: 24rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,.65); background: #eee; }
.hero-info { flex: 1; }
.name { display: block; font-size: 38rpx; font-weight: 700; }
.phone { display: block; margin-top: 8rpx; font-size: 25rpx; opacity: .9; }
.hint { display: block; margin-top: 14rpx; font-size: 23rpx; opacity: .82; }
.card { margin: 20rpx; padding: 28rpx; background: #fff; border-radius: 18rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.05); }
.section-title { font-size: 31rpx; font-weight: 700; color: #20242b; }
.section-subtitle { margin-top: 8rpx; font-size: 23rpx; color: #9aa1aa; }
.skill-grid { display: flex; flex-wrap: wrap; margin-top: 22rpx; gap: 16rpx; }
.skill-item { position: relative; box-sizing: border-box; width: calc(50% - 8rpx); min-height: 150rpx; padding: 22rpx; border: 2rpx solid #edf0f4; border-radius: 16rpx; background: #fafbfc; }
.skill-item.selected { border-color: #1677ff; background: #f0f7ff; }
.skill-icon { display: block; font-size: 48rpx; }
.skill-name { display: block; margin-top: 10rpx; font-size: 27rpx; font-weight: 600; color: #30343b; }
.skill-status { display: block; margin-top: 6rpx; font-size: 21rpx; color: #1677ff; }
.field { margin-top: 28rpx; }
.label { display: block; margin-bottom: 12rpx; font-size: 26rpx; color: #424851; font-weight: 600; }
.input-row { display: flex; align-items: center; }
.input { box-sizing: border-box; width: 100%; height: 84rpx; padding: 0 22rpx; border: 1rpx solid #e5e8ed; border-radius: 14rpx; background: #fafbfc; font-size: 28rpx; }
.input.small { width: 180rpx; text-align: center; }
.unit { margin-left: 12rpx; font-size: 26rpx; color: #666; }
.textarea { box-sizing: border-box; width: 100%; height: 190rpx; padding: 20rpx; border: 1rpx solid #e5e8ed; border-radius: 14rpx; background: #fafbfc; font-size: 28rpx; line-height: 1.6; }
.counter { display: block; text-align: right; margin-top: 6rpx; font-size: 20rpx; color: #aaa; }
.notice { margin: 20rpx; padding: 24rpx; border-radius: 16rpx; background: #eef6ff; }
.notice-title { display: block; font-size: 26rpx; font-weight: 700; color: #1677ff; }
.notice-text { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.6; color: #64748b; }
.save-btn { margin: 28rpx 20rpx 0; height: 90rpx; line-height: 90rpx; border-radius: 16rpx; background: #1677ff; color: #fff; font-size: 31rpx; font-weight: 600; }
.save-btn::after { border: none; }
