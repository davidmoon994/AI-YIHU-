<view class="page">

  <view class="page-title">培训中心</view>
  <view class="page-sub">提升专业技能，提供更好服务</view>

  <!-- 课程列表 -->
  <block wx:if="{{courses.length > 0}}">
    <view class="course-card" wx:for="{{courses}}" wx:key="id" bindtap="viewDetail" data-id="{{item.id}}">
      <view class="course-header">
        <text class="course-title">{{item.title}}</text>
        <text class="course-category">{{item.category || '通用'}}</text>
      </view>
      <view class="course-meta">
        <text wx:if="{{item.duration}}">⏱ {{item.duration}}分钟</text>
        <text>📖 点击查看详情</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && courses.length === 0}}">
    <text>暂无课程</text>
  </view>

  <!-- 课程详情弹窗 -->
  <view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="detail-panel" catchtap="">
      <view class="detail-header">
        <text class="detail-title">{{currentCourse.title}}</text>
        <text class="detail-close" bindtap="closeDetail">✕</text>
      </view>
      <scroll-view scroll-y class="detail-content">
        <view class="detail-meta">
          <text wx:if="{{currentCourse.category}}">分类：{{currentCourse.category}}</text>
          <text wx:if="{{currentCourse.duration}}">时长：{{currentCourse.duration}}分钟</text>
        </view>
        <view class="detail-body">
          <text>{{currentCourse.content}}</text>
        </view>
      </scroll-view>
      <view class="detail-footer">
        <button class="btn-finish" bindtap="finishCourse" data-id="{{currentCourse.id}}">完成学习</button>
      </view>
    </view>
  </view>

</view>
