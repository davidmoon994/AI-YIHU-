.page{background:#f5f5f5;min-height:100vh;padding:20rpx 20rpx 50rpx;box-sizing:border-box}.hero{background:#fff;border-radius:18rpx;padding:30rpx;display:flex;align-items:center;margin-bottom:20rpx}.hero-icon{font-size:64rpx;margin-right:22rpx}.hero-title{font-size:34rpx;font-weight:700;color:#222;display:block}.hero-no{font-size:22rpx;color:#999;display:block;margin-top:8rpx}.card{background:#fff;border-radius:18rpx;padding:26rpx;margin-bottom:20rpx}.card-title{font-size:29rpx;font-weight:700;color:#222;margin-bottom:22rpx}.steps{display:flex;justify-content:space-between;position:relative}.step{flex:1;text-align:center;color:#bbb;font-size:21rpx;position:relative}.step:not(:last-child):after{content:'';position:absolute;height:4rpx;background:#eee;top:11rpx;left:55%;right:-45%;z-index:0}.step.active{color:#1677ff}.step.active:not(:last-child):after{background:#bcd5ff}.dot{width:22rpx;height:22rpx;border-radius:50%;background:#ddd;margin:0 auto 12rpx;position:relative;z-index:1}.step.active .dot{background:#1677ff}.row{display:flex;padding:15rpx 0;border-bottom:1rpx solid #f0f0f0}.row:last-child{border-bottom:none}.label{width:190rpx;color:#999;font-size:25rpx;flex-shrink:0}.value{flex:1;color:#333;font-size:25rpx;line-height:1.6}.multiline{white-space:normal}.money{font-weight:700}.remark{font-size:25rpx;color:#555;line-height:1.7;white-space:pre-wrap}.notice{background:#fffbe6;color:#8a6d1d;border-radius:14rpx;padding:22rpx;font-size:23rpx;line-height:1.6}.loading,.empty{text-align:center;padding:180rpx 20rpx;color:#999;font-size:27rpx}
