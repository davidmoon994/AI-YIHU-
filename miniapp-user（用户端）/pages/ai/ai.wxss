.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f6f7fb;
}

/* 聊天区域 */
.chat-area {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}
.chat-inner {
  padding-bottom: 20rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-user {
  flex-direction: row-reverse;
}

/* 头像 */
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.avatar-user {
  background: #1677ff;
  color: #fff;
  margin-left: 16rpx;
}
.avatar-ai {
  background: linear-gradient(135deg, #52c41a, #1677ff);
  color: #fff;
  margin-right: 16rpx;
}

/* 气泡 */
.bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-wrap: break-word;
  position: relative;
}
.bubble-user {
  background: #1677ff;
  color: #fff;
  border-top-right-radius: 6rpx;
}
.bubble-ai {
  background: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* 正在输入 */
.typing {
  color: #999;
  font-style: italic;
}

/* 复制按钮 */
.copy-btn {
  display: inline-block;
  font-size: 22rpx;
  color: #1677ff;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border: 1rpx solid #1677ff;
  border-radius: 8rpx;
}

/* 快捷面板 */
.quick-panel {
  padding: 20rpx;
  background: #fff;
  margin: 0 20rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.quick-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.quick-grid {
  display: flex;
  justify-content: space-between;
}
.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  background: #f6f7fb;
  width: 22%;
}
.quick-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}
.quick-label {
  font-size: 24rpx;
  color: #333;
}

/* 输入区域 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.clear-btn {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 16rpx;
  flex-shrink: 0;
}
.input-field {
  flex: 1;
  background: #f6f7fb;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin: 0 12rpx;
}
.send-btn {
  font-size: 28rpx;
  color: #fff;
  background: #ccc;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  flex-shrink: 0;
}
.send-btn.active {
  background: #1677ff;
}
