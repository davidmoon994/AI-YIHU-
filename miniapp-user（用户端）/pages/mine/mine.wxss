.page{background:#f6f7fb;min-height:100vh;padding-bottom:40rpx}.login-card,.profile-card{background:linear-gradient(135deg,#1677ff,#00c6ff);margin:20rpx;border-radius:20rpx;padding:34rpx;color:#fff}.login-card{text-align:center;padding:60rpx 30rpx}.login-avatar{font-size:72rpx;margin-bottom:16rpx}.login-text{font-size:28rpx;margin-bottom:24rpx}.login-btn{display:inline-block;background:#fff;color:#1677ff;padding:18rpx 60rpx;border-radius:40rpx;font-size:28rpx;font-weight:bold}.profile-top{display:flex;align-items:center}.profile-avatar,.profile-avatar-placeholder{width:96rpx;height:96rpx;border-radius:50%;flex-shrink:0}.profile-avatar{border:4rpx solid rgba(255,255,255,.5)}.profile-avatar-placeholder{background:rgba(255,255,255,.28);display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:bold}.profile-info{flex:1;margin-left:20rpx}.profile-name{font-size:32rpx;font-weight:bold}.profile-phone{font-size:24rpx;opacity:.85;margin-top:6rpx}.logout-btn{font-size:24rpx;padding:8rpx 20rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:20rpx}.profile-stats{text-align:center;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.2)}.stat-num{font-size:36rpx;font-weight:bold;display:block}.stat-label{font-size:22rpx;opacity:.85;display:block;margin-top:4rpx}.tab-bar{display:flex;background:#fff;margin:0 20rpx;border-radius:14rpx;overflow:hidden}.tab-item{flex:1;text-align:center;padding:24rpx 0;font-size:28rpx;color:#666;position:relative}.tab-item.active{color:#1677ff;font-weight:bold;background:#f0f5ff}.badge{position:absolute;top:8rpx;margin-left:8rpx;background:#ff4d4f;color:#fff;font-size:20rpx;padding:2rpx 10rpx;border-radius:20rpx}.filter-bar,.status-bar{white-space:nowrap;padding:18rpx 20rpx 6rpx;display:flex}.status-bar{padding-top:6rpx;padding-bottom:18rpx}.filter-item,.status-filter{display:inline-block;padding:12rpx 24rpx;font-size:25rpx;color:#666;background:#fff;border-radius:30rpx;margin-right:14rpx}.filter-item.active{background:#1677ff;color:#fff}.status-filter.active{background:#eef6ff;color:#1677ff;font-weight:bold}.order-card{background:#fff;margin:0 20rpx 16rpx;border-radius:18rpx;padding:24rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,.04)}.order-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}.service-title{font-size:30rpx;font-weight:bold;color:#333}.service-icon{margin-right:10rpx}.order-status{font-size:24rpx;font-weight:bold}.order-no{font-size:22rpx;color:#aaa;margin-bottom:14rpx}.status-pending{color:#faad14}.status-paid,.status-dispatching{color:#1677ff}.status-assigned,.status-accepted,.status-arrived,.status-serving{color:#52c41a}.status-completed{color:#999}.status-cancelled,.status-closed{color:#bbb}.status-refund{color:#ff7a45}.order-body{padding:16rpx 0;border-top:1rpx solid #f3f3f3;border-bottom:1rpx solid #f0f0f0}.order-info,.amount-row{display:flex;font-size:26rpx;color:#333;margin-bottom:10rpx}.order-info:last-child{margin-bottom:0}.info-label{width:140rpx;color:#999;flex-shrink:0}.info-value{flex:1}.amount-row{justify-content:space-between;align-items:center;margin-top:12rpx}.order-amount{color:#ff4d4f;font-weight:bold;font-size:32rpx}.order-actions{display:flex;justify-content:flex-end;flex-wrap:wrap;margin-top:16rpx}.action-btn{padding:12rpx 24rpx;font-size:25rpx;border-radius:10rpx;background:#1677ff;color:#fff;margin-left:12rpx;margin-top:6rpx}.action-btn.secondary{background:#f5f5f5;color:#666}.load-more{text-align:center;padding:30rpx;font-size:26rpx;color:#999}.msg-toolbar{padding:16rpx 20rpx;text-align:right}.read-all-btn{display:inline-block;font-size:26rpx;color:#1677ff;padding:8rpx 20rpx;border:1rpx solid #1677ff;border-radius:8rpx}.msg-card{background:#fff;margin:0 20rpx 12rpx;border-radius:12rpx;padding:24rpx}.msg-card.unread{border-left:6rpx solid #1677ff}.msg-title{font-size:28rpx;font-weight:bold;color:#333;margin-bottom:8rpx}.msg-content{font-size:26rpx;color:#666;line-height:1.5}.msg-footer{dis