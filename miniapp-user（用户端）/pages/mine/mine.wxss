.page {
  background: #f6f7fb;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ====== 登录 ====== */
.login-card {
  background: linear-gradient(135deg, #1677ff, #00c6ff);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  color: #fff;
}
.login-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 20rpx;
}
.login-text {
  font-size: 30rpx;
  margin-bottom: 24rpx;
}
.login-btn {
  display: inline-block;
  background: #fff;
  color: #1677ff;
  padding: 18rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

/* ====== 用户信息 ====== */
.profile-card {
  background: linear-gradient(135deg, #1677ff, #00c6ff);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  color: #fff;
}
.profile-top {
  display: flex;
  align-items: center;
}
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  flex-shrink: 0;
}
.profile-avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.profile-info {
  flex: 1;
  margin-left: 20rpx;
}
.profile-name {
  font-size: 32rpx;
  font-weight: bold;
}
.profile-phone {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}
.logout-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 8rpx;
}
.profile-stats {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}
.stat-item {
  text-align: center;
}
.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}
.stat-label {
  font-size: 22rpx;
  opacity: 0.8;
  display: block;
  margin-top: 4rpx;
}

/* ====== Tab ====== */
.tab-bar {
  display: flex;
  background: #fff;
  margin: 0 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}
.tab-item.active {
  color: #1677ff;
  font-weight: bold;
  background: #f0f5ff;
}
.badge {
  position: absolute;
  top: 8rpx;
  right: 20%;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

/* ====== 筛选 ====== */
.filter-bar {
  white-space: nowrap;
  padding: 20rpx;
  display: flex;
}
.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 30rpx;
  margin-right: 16rpx;
}
.filter-item.active {
  background: #1677ff;
  color: #fff;
}

/* ====== 订单 ====== */
.order-card {
  background: #fff;
  margin: 0 20rpx 16rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.order-no {
  font-size: 24rpx;
  color: #999;
}
.order-status {
  font-size: 24rpx;
  font-weight: bold;
}
.status-pending { color: #faad14; }
.status-paid, .status-dispatching { color: #1677ff; }
.status-assigned, .status-accepted, .status-arrived, .status-serving { color: #52c41a; }
.status-completed { color: #999; }
.status-cancelled { color: #ccc; }
.status-refund { color: #ff7a45; }

.order-body {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.order-info {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 6rpx;
}
.order-amount {
  color: #ff4d4f;
  font-weight: bold;
  font-size: 30rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}
.action-btn {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  background: #1677ff;
  color: #fff;
}
.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* ====== 消息 ====== */
.msg-toolbar {
  padding: 16rpx 20rpx;
  text-align: right;
}
.read-all-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #1677ff;
  padding: 8rpx 20rpx;
  border: 1rpx solid #1677ff;
  border-radius: 8rpx;
}
.msg-card {
  background: #fff;
  margin: 0 20rpx 12rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}
.msg-card.unread {
  border-left: 6rpx solid #1677ff;
}
.msg-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.msg-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.msg-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}
.msg-time {
  font-size: 22rpx;
  color: #ccc;
}
.msg-delete {
  font-size: 22rpx;
  color: #ff4d4f;
}

/* ====== 详情弹窗 ====== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.detail-popup {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}
.detail-loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.detail-label {
  font-size: 28rpx;
  color: #999;
}
.detail-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 60%;
}
.detail-value.price {
  color: #ff4d4f;
  font-weight: bold;
}
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  justify-content: center;
}

/* ====== 空状态 ====== */
.empty {
  text-align: center;
  padding: 120rpx 20rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
  display: block;
  margin-top: 20rpx;
}
