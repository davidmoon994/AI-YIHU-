<view class="page">

  <!-- 顶部横幅 -->
  <view class="top-banner">
    <view class="banner-content">
      <view class="banner-greeting">
        {{isLogin && profile ? 'Hi, ' + (profile.nickname || '用户') : '欢迎使用'}}
      </view>
      <view class="banner-title">AI社区就医陪诊服务</view>
      <view class="banner-sub">让家人看病更轻松 · 专业陪诊更放心</view>
    </view>
    <view class="banner-badge" wx:if="{{unreadCount > 0}}" bindtap="goOrders">
      <text>{{unreadCount}}条新消息</text>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-hint" wx:if="{{!isLogin}}" bindtap="goLogin">
    <text>点击登录，享受完整服务</text>
  </view>

  <!-- 进行中的订单 -->
  <view class="active-order-card" wx:if="{{hasActiveOrder && recentOrders.length > 0}}" bindtap="goOrders">
    <view class="active-order-header">
      <text class="active-label">进行中的订单</text>
      <text class="active-more">查看全部 ></text>
    </view>
    <view class="active-order-item" wx:for="{{recentOrders}}" wx:key="id" wx:if="{{index < 1}}">
      <view class="active-hospital">{{item.hospital_name || '未指定医院'}}</view>
      <view class="active-status">{{item.order_status === 'pending' ? '待支付' : item.order_status === 'dispatching' ? '派单中' : item.order_status === 'serving' ? '服务中' : '进行中'}}</view>
    </view>
  </view>

  <!-- 核心服务入口 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">服务项目</text>
    </view>
    <view class="service-grid">
      <view
        class="service-entry"
        wx:for="{{serviceEntries}}"
        wx:key="type"
        bindtap="goService"
        data-type="{{item.type}}"
      >
        <text class="entry-icon">{{item.icon}}</text>
        <text class="entry-label">{{item.label}}</text>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- AI 智能助手入口 -->
  <view class="ai-card" bindtap="goAI">
    <view class="ai-left">
      <text class="ai-icon">🤖</text>
      <view class="ai-text">
        <view class="ai-title">AI健康助手</view>
        <view class="ai-desc">症状分析 · 科室推荐 · 就医规划</view>
      </view>
    </view>
    <view class="ai-arrow">></view>
  </view>

  <!-- 近期订单 -->
  <view class="section" wx:if="{{recentOrders.length > 0}}">
    <view class="section-header">
      <text class="section-title">最近订单</text>
      <text class="section-more" bindtap="goOrders">查看全部 ></text>
    </view>
    <view class="order-item" wx:for="{{recentOrders}}" wx:key="id" bindtap="goOrders">
      <view class="order-left">
        <view class="order-hospital">{{item.hospital_name || '未指定医院'}}</view>
        <view class="order-time">{{item.appointment_time || ''}}</view>
      </view>
      <view class="order-right">
        <view class="order-amount">¥{{item.payable_amount || 0}}</view>
      </view>
    </view>
  </view>

  <!-- 服务说明 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">服务说明</text>
    </view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-icon">✓</text>
        <text>专业陪诊师持证上岗，全程陪护</text>
      </view>
      <view class="info-item">
        <text class="info-icon">✓</text>
        <text>医院陪同 · 挂号协助 · 检查指引 · 取报告</text>
      </view>
      <view class="info-item">
        <text class="info-icon">✓</text>
        <text>AI智能分析，就医流程一键规划</text>
      </view>
    </view>
  </view>

  <!-- 价格说明 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">价格说明</text>
    </view>
    <view class="price-table">
      <view class="price-row">
        <text class="price-name">标准陪诊</text>
        <text class="price-val">199元/次</text>
      </view>
      <view class="price-row">
        <text class="price-name">代挂号</text>
        <text class="price-val">99元起</text>
      </view>
      <view class="price-row">
        <text class="price-name">接送服务</text>
        <text class="price-val">50元起</text>
      </view>
      <view class="price-row">
        <text class="price-name">就医规划</text>
        <text class="price-val">29元起</text>
      </view>
    </view>
  </view>

  <!-- 底部CTA -->
  <view class="bottom-bar">
    <view class="cta" bindtap="goService" data-type="escort">
      立即预约陪诊
    </view>
  </view>

</view>
