.page{min-height:100vh;background:#f6f7fb;padding:24rpx}.card{background:#fff;border-radius:20rpx;padding:36rpx 28rpx}.title{text-align:center;font-size:34rpx;font-weight:bold;color:#222}.service{text-align:center;color:#999;font-size:24rpx;margin-top:12rpx}.score-title{text-align:center;font-size:28rpx;color:#555;margin-top:48rpx}.stars{text-align:center;margin-top:24rpx}.star{font-size:64rpx;color:#ddd;margin:0 7rpx}.star.active{color:#ffb000}.score-text{text-align:center;color:#ff9f00;font-size:26rpx;margin-top:8rpx}.content{box-sizing:border-box;width:100%;height:240rpx;background:#f7f8fa;border-radius:14rpx;padding:20rpx;margin-top:40rpx;font-size:27rpx}.anonymous-row{display:flex;align-items:center;margin-top:24rpx;color:#666;font-size:26rpx}.check{font-size:36rpx;margin-right:10rpx}.submit,.done{margin-top:40rpx;text-align:center;padding:22rpx;border-radius:12rpx;font-size:29rpx}.submit{background:#1677ff;color:#fff}.done{background:#f5f5f5;color:#999}
