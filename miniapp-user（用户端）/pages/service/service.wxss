.page {
  background: #f6f7fb;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 步骤条 */
.steps-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 30rpx;
  background: #fff;
}
.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: #ccc;
}
.step-item.active {
  color: #1677ff;
}
.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #e8e8e8;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}
.step-item.active .step-dot {
  background: #1677ff;
  color: #fff;
}
.step-line {
  width: 60rpx;
  height: 4rpx;
  background: #e8e8e8;
  margin: 0 8rpx;
  margin-bottom: 28rpx;
}
.step-line.done {
  background: #1677ff;
}

/* 内容区 */
.section {
  padding: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.list-title {
  font-size: 24rpx;
  color: #999;
  margin: 20rpx 0 12rpx;
}

/* 服务卡片 */
.service-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.service-card.selected {
  border-color: #1677ff;
  background: #f0f5ff;
}
.service-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.service-info {
  flex: 1;
}
.service-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.service-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.service-price {
  font-size: 26rpx;
  color: #ff4d4f;
  font-weight: bold;
}
.service-check {
  color: #1677ff;
  font-size: 32rpx;
  margin-left: 12rpx;
}

/* 选中卡片 */
.selected-card {
  background: #e6f7ff;
  border: 2rpx solid #1677ff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.selected-label {
  font-size: 22rpx;
  color: #1677ff;
  margin-bottom: 6rpx;
}
.selected-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.selected-info {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

/* 列表项 */
.patient-item, .address-item {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.patient-name, .address-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.patient-info, .address-detail {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
}

.add-btn {
  text-align: center;
  padding: 20rpx;
  color: #1677ff;
  font-size: 28rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.form-label {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  flex-shrink: 0;
}
.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}
.picker-value.placeholder {
  color: #ccc;
}

/* 确认页 */
.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.confirm-row:first-of-type {
  border-radius: 12rpx 12rpx 0 0;
}
.confirm-row:last-of-type {
  border-radius: 0 0 12rpx 12rpx;
  border-bottom: none;
}
.confirm-label {
  font-size: 28rpx;
  color: #999;
}
.confirm-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 60%;
}
.remark-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}
.btn-prev {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-next {
  flex: 2;
  text-align: center;
  padding: 24rpx;
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.btn-submit {
  flex: 2;
  text-align: center;
  padding: 24rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
}
.btn-submit.disabled {
  opacity: 0.6;
}

/* ====== 弹窗 ====== */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.popup {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh;
  overflow-y: auto;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}
.popup-form {
  max-height: 80vh;
}
.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 24rpx;
}
.popup-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}
.popup-item.add {
  color: #1677ff;
  text-align: center;
  border-bottom: none;
  margin-top: 12rpx;
}
.form-group {
  padding: 0 10rpx;
}
.form-input {
  background: #f6f7fb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.form-row-inline {
  padding: 12rpx 0;
}
.radio-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}
.radio-label {
  font-size: 28rpx;
  color: #666;
}
.radio {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}
.radio.active {
  background: #e6f7ff;
  color: #1677ff;
  border: 1rpx solid #1677ff;
}
.popup-btn {
  text-align: center;
  padding: 24rpx;
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin-top: 20rpx;
}

