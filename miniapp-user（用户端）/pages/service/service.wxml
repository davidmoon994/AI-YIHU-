<view class="page">
  <view class="steps-bar">
    <view class="step-item {{step>=1?'active':''}}"><view class="step-dot">1</view><text>服务</text></view><view class="step-line {{step>=2?'done':''}}"></view>
    <view class="step-item {{step>=2?'active':''}}"><view class="step-dot">2</view><text>对象</text></view><view class="step-line {{step>=3?'done':''}}"></view>
    <view class="step-item {{step>=3?'active':''}}"><view class="step-dot">3</view><text>需求</text></view><view class="step-line {{step>=4?'done':''}}"></view>
    <view class="step-item {{step>=4?'active':''}}"><view class="step-dot">4</view><text>时间</text></view><view class="step-line {{step>=5?'done':''}}"></view>
    <view class="step-item {{step>=5?'active':''}}"><view class="step-dot">5</view><text>确认</text></view>
  </view>

  <view class="section" wx:if="{{step===1}}"><view class="section-title">选择家庭服务</view><view class="service-card {{selectedType===item.value?'selected':''}}" wx:for="{{serviceTypes}}" wx:key="value" bindtap="selectServiceType" data-value="{{item.value}}"><view class="service-icon">{{item.icon}}</view><view class="service-info"><view class="service-name">{{item.label}}</view><view class="service-desc">{{item.desc}}</view></view><view class="service-price">{{item.price}}</view></view></view>

  <view class="section" wx:if="{{step===2}}"><view class="section-title">选择服务对象</view><view class="selected-card" wx:if="{{selectedPatient}}"><view class="selected-label">已选择</view><view class="selected-name">{{selectedPatient.name}}</view><view class="selected-info">{{selectedPatient.phone}}</view></view><view class="list-title" wx:if="{{patients.length}}">我的服务对象</view><view class="patient-item" wx:for="{{patients}}" wx:key="id" bindtap="selectPatient" data-idx="{{index}}"><view class="patient-name">{{item.name}}</view><view class="patient-info">{{item.phone}} · {{item.relation||'本人'}}</view></view><view class="add-btn" bindtap="openPatientForm">+ 添加服务对象</view></view>

  <view class="section" wx:if="{{step===3}}"><view class="section-title">{{currentServiceLabel}}服务需求</view><view class="form-card"><view class="form-group" wx:for="{{serviceFields}}" wx:key="key"><view class="field-label">{{item.label}}<text wx:if="{{item.required}}" class="required"> *</text></view><input class="form-input" placeholder="{{item.placeholder}}" value="{{serviceExtra[item.key]}}" bindinput="onExtraInput" data-key="{{item.key}}"/></view></view><view class="tips-box">请如实填写需求信息，方便平台匹配合适的服务人员。</view></view>

  <view class="section" wx:if="{{step===4}}"><view class="section-title">服务地址与预约时间</view><view class="selected-card" wx:if="{{selectedAddress}}"><view class="selected-label">已选择地址</view><view class="selected-name">{{selectedAddress.receiverName}} {{selectedAddress.receiverPhone}}</view><view class="selected-info">{{selectedAddress.province}}{{selectedAddress.city}}{{selectedAddress.district}}{{selectedAddress.detailAddress}}</view></view><view class="list-title" wx:if="{{addresses.length}}">我的地址</view><view class="address-item" wx:for="{{addresses}}" wx:key="id" bindtap="selectAddress" data-idx="{{index}}"><view class="address-name">{{item.receiverName}} {{item.receiverPhone}}</view><view class="address-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</view></view><view class="add-btn" bindtap="openAddressForm">+ 添加地址</view><view class="section-title">预约时间</view><view class="form-row"><text class="form-label">日期</text><picker mode="date" value="{{appointmentDate}}" start="{{minDate}}" bindchange="onDateChange"><view class="picker-value">{{appointmentDate||'请选择日期'}}</view></picker></view><view class="form-row"><text class="form-label">时间</text><picker mode="time" value="{{appointmentTime}}" bindchange="onTimeChange"><view class="picker-value">{{appointmentTime||'请选择时间'}}</view></picker></view></view>

  <view class="section" wx:if="{{step===5}}"><view class="section-title">确认预约信息</view><view class="confirm-row"><text class="confirm-label">服务</text><text class="confirm-value">{{currentServiceLabel}}</text></view><view class="confirm-row"><text class="confirm-label">服务对象</text><text class="confirm-value">{{selectedPatient.name}} {{selectedPatient.phone}}</text></view><view class="confirm-row" wx:for="{{serviceFields}}" wx:key="key"><text class="confirm-label">{{item.label}}</text><text class="confirm-value">{{serviceExtra[item.key]||'未填写'}}</text></view><view class="confirm-row"><text class="confirm-label">预约时间</text><text class="confirm-value">{{appointmentDate}} {{appointmentTime}}</text></view><view class="form-group"><view class="field-label">补充备注</view><input class="form-input" placeholder="选填，补充特殊需求" value="{{remark}}" bindinput="onRemarkInput"/></view></view>

  <view class="bottom-actions"><view class="btn-prev" bindtap="prevStep" wx:if="{{step>1}}">上一步</view><view class="btn-next" bindtap="nextStep" wx:if="{{step<5}}">下一步</view><view class="btn-submit {{submitting?'disabled':''}}" bindtap="submitOrder" wx:if="{{step===5}}">{{submitting?'提交中...':'确认提交预约'}}</view></view>

  <view class="overlay" wx:if="{{showPatientForm}}" bindtap="closeOverlay"><view class="popup popup-form" catchtap=""><view class="popup-title">添加服务对象</view><input class="form-input" placeholder="姓名 *" value="{{newPatient.name}}" bindinput="onPatientInput" data-field="name"/><input class="form-input" placeholder="联系电话" type="number" value="{{newPatient.phone}}" bindinput="onPatientInput" data-field="phone"/><input class="form-input" placeholder="身份证号（就医陪诊可填写）" value="{{newPatient.idCard}}" bindinput="onPatientInput" data-field="idCard"/><view class="popup-btn" bindtap="savePatient">保存</view></view></view>
  <view class="overlay" wx:if="{{showAddressForm}}" bindtap="closeOverlay"><view class="popup popup-form" catchtap=""><view class="popup-title">添加服务地址</view><input class="form-input" placeholder="联系人 *" value="{{newAddress.receiverName}}" bindinput="onAddressInput" data-field="receiverName"/><input class="form-input" placeholder="手机号 *" type="number" value="{{newAddress.receiverPhone}}" bindinput="onAddressInput" data-field="receiverPhone"/><input class="form-input" placeholder="省份" value="{{newAddress.province}}" bindinput="onAddressInput" data-field="province"/><input class="form-input" placeholder="城市" value="{{newAddress.city}}" bindinput="onAddressInput" data-field="city"/><input class="form-input" placeholder="区/县" value="{{newAddress.district}}" bindinput="onAddressInput" data-field="district"/><input class="form-input" placeholder="详细地址 *" value="{{newAddress.detailAddress}}" bindinput="onAddressInput" data-field="detailAddress"/><view class="popup-btn" bindtap="saveAddress">保存</view></view></view>
</view>
