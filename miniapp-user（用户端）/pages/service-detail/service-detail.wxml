<view class="page" wx:if="{{service}}"><view class="hero"><text class="icon">{{service.icon}}</text><view><view class="name">{{service.name}}</view><view class="slogan">{{service.slogan}}</view></view></view><view class="card"><view class="title">项目介绍</view><view class="text">{{service.intro}}</view></view><view class="card"><view class="title">可以为您做什么</view><view wx:for="{{service.items}}" wx:key="*this" class="row">✓ {{item}}</view></view><view class="card"><view class="title">服务流程</view><view wx:for="{{steps}}" wx:key="*this" class="step">{{index+1}}. {{item}}</view></view><view class="card"><view class="title">预约前请准备</view><view wx:for="{{service.prepare}}" wx:key="*this" class="row">• {{item}}</view></view><view class="card notice"><view class="title">服务说明</view><view class="text">{{service.notice}}</view></view><view class="bottom"><button class="order" bindtap="goOrder">立即预约 {{service.name}}</button></view></view>