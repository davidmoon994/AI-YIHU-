.page{background:#f6f7fb;min-height:100vh;padding-bottom:140rpx}.hero{padding:60rpx 36rpx;background:linear-gradient(135deg,#1677ff,#69a8ff);color:#fff;display:flex;align-items:center}.icon{font-size:90rpx;margin-right:24rpx}.name{font-size:42rpx;font-weight:700}.slogan{font-size:26rpx;margin-top:12rpx}.card{background:#fff;margin:24rpx;border-radius:20rpx;padding:30rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04)}.title{font-size:32rpx;font-weight:700;margin-bottom:20rpx}.text,.row,.step{font-size:28rpx;line-height:1.8;color:#555;margin:10rpx 0}.notice{border-left:8rpx solid #ffb020}.bottom{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 24rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.order{background:#1677ff;color:#fff;border-radius:48rpx;font-size:32rpx}