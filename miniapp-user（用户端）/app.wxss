/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f6f7fb;
  box-sizing: border-box;
}

view, text {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: none;
}
