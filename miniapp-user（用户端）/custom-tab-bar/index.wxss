.tab-bar {
  display: flex;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  padding-bottom: env(safe-area-inset-bottom);
  height: 100rpx;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  line-height: 1;
}

.tab-bar-item.active .tab-text {
  color: #1677ff;
  font-weight: bold;
}
